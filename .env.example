# Server-only: Namespace API key (Namespace App > Offchain > API Keys), scoped to your parent name
NAMESPACE_API_KEY=

# The ENS name you registered on Sepolia and configured with the Namespace Hybrid Resolver
PARENT_NAME=yourdemo.eth

# Sepolia RPC used to resolve names
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Humanode Testnet 5 (use 5234 + the mainnet RPC for mainnet)
HUMANODE_CHAIN_ID=14853
HUMANODE_RPC=https://explorer-rpc-http.testnet5.stages.humanode.io
HUMANODE_SYMBOL=eHMND

# Experimental: Namespace REST base URL, to also write a raw ENSIP-11 coin-type record.
# Leave empty to skip. Unverified that it serves Sepolia names.
NAMESPACE_REST_URL=
